{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "A user's profile data.",
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "description": "The user's unique handle (e.g., username@flux)."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user account was created."
        },
        "profileLastUpdatedAt": {
          "type": "string",
          "description": "The timestamp when the user's profile (name/handle) was last updated."
        },
        "status": {
          "type": "string",
          "description": "The user's global status or role in the application.",
          "enum": ["owner", "admin", "user"],
          "default": "user"
        },
        "theme": {
          "type": "string",
          "description": "The user's preferred color theme.",
          "enum": ["default", "void", "bright", "crimson", "jade"],
          "default": "default"
        },
        "privacy": {
          "type": "object",
          "description": "User's privacy settings.",
          "properties": {
            "whoCanDm": {
              "type": "string",
              "enum": ["anyone", "friends"],
              "default": "anyone"
            },
            "whoCanAdd": {
              "type": "string",
              "enum": ["anyone", "mutual", "fof", "none"],
              "default": "anyone"
            }
          },
          "required": ["whoCanDm", "whoCanAdd"]
        },
        "notifications": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "friendRequests": {
              "type": "boolean",
              "default": true
            },
            "mentions": {
              "type": "boolean",
              "default": true
            },
            "dms": {
              "type": "boolean",
              "default": false
            }
          },
          "required": ["friendRequests", "mentions", "dms"]
        }
      },
      "required": ["handle", "displayName", "email", "createdAt", "profileLastUpdatedAt", "status", "theme", "privacy", "notifications"]
    },
    "friend": {
      "title": "Friend",
      "description": "Represents a friendship link between two users.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the friend."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the friendship was established."
        }
      },
      "required": ["userId", "createdAt"]
    },
    "blockedUser": {
      "title": "Blocked User",
      "description": "Represents a user blocked by another user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the blocked user."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user was blocked."
        }
      },
      "required": ["userId", "createdAt"]
    },
    "friendRequest": {
      "title": "Friend Request",
      "description": "Represents a friend request sent from one user to another.",
      "type": "object",
      "properties": {
        "fromUserId": {
          "type": "string",
          "description": "The UID of the user sending the request."
        },
        "toUserId": {
          "type": "string",
          "description": "The UID of the user receiving the request."
        },
        "status": {
          "type": "string",
          "enum": ["pending"],
          "description": "The status of the friend request."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the request was sent."
        }
      },
      "required": ["fromUserId", "toUserId", "status", "createdAt"]
    },
    "message": {
      "title": "Chat Message",
      "description": "A single message within a chat conversation.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "The UID of the user who sent the message."
        },
        "text": {
          "type": "string",
          "description": "The content of the message."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the message was sent."
        },
        "conversationId": {
          "type": "string",
          "description": "The ID of the conversation this message belongs to."
        },
        "editedAt": {
          "type": "string",
          "description": "The timestamp when the message was last edited."
        }
      },
      "required": [
        "authorId",
        "text",
        "createdAt",
        "conversationId"
      ]
    },
    "server": {
      "title": "Server",
      "description": "Represents a server/community in the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the server."
        },
        "ownerId": {
          "type": "string",
          "description": "The UID of the user who owns the server."
        },
        "iconURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the server's icon."
        },
        "inviteCode": {
          "type": "string",
          "description": "A unique, short code to join the server."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the server was created."
        },
        "trialModeEnabled": {
          "type": "boolean",
          "description": "If true, new members will join with the 'trial' role.",
          "default": false
        },
        "acceptingInvites": {
          "type": "boolean",
          "description": "If false, new users cannot join via invite code.",
          "default": true
        },
        "featured": {
            "type": "boolean",
            "description": "If true, this server is featured in the explore page.",
            "default": false
        }
      },
      "required": ["name", "ownerId", "inviteCode", "createdAt"]
    },
    "serverMember": {
      "title": "Server Member",
      "description": "Represents a user's membership and role within a server.",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["owner", "admin", "user", "trial"],
          "description": "The role of the user in the server."
        },
        "joinedAt": {
          "type": "string",
          "description": "The timestamp when the user joined the server."
        }
      },
      "required": ["role", "joinedAt"]
    },
    "channel": {
      "title": "Channel",
      "description": "A text or voice channel within a server.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the channel."
        },
        "type": {
          "type": "string",
          "enum": ["text", "voice"],
          "description": "The type of the channel."
        },
        "topic": {
          "type": "string",
          "description": "The channel's topic or description."
        },
        "serverId": {
           "type": "string",
          "description": "The ID of the server this channel belongs to."
        },
        "userAccess": {
            "type": "string",
            "enum": ["readwrite", "readonly", "none"],
            "description": "Controls access for users with the 'user' role.",
            "default": "readwrite"
        }
      },
      "required": ["name", "type", "serverId", "userAccess"]
    },
    "serverMessage": {
      "title": "Server Message",
      "description": "A single message within a server channel.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "channelId": {
          "type": "string"
        },
        "editedAt": {
          "type": "string"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": ["authorId", "text", "createdAt", "channelId"]
    },
    "voiceParticipant": {
      "title": "Voice Channel Participant",
      "description": "A user currently in a voice channel.",
      "type": "object",
      "properties": {
        "peerId": {
          "type": "string",
          "description": "The PeerJS ID of the participant."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        }
      },
      "required": ["peerId", "userId", "displayName"]
    },
    "dmCall": {
      "title": "Direct Message Call",
      "description": "Represents a peer-to-peer call in a direct message.",
      "type": "object",
      "properties": {
        "callerId": {
          "type": "string"
        },
        "callerPeerId": {
          "type": "string"
        },
        "receiverId": {
          "type": "string"
        },
        "receiverPeerId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["ringing", "connected", "ended", "declined", "missed", "cancelled"]
        },
        "createdAt": {
          "type": "string"
        },
        "endedAt": {
            "type": "string"
        }
      },
      "required": ["callerId", "callerPeerId", "receiverId", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": {
        "$ref": "#/entities/friend"
      },
      "description": "A subcollection storing the user's friends."
    },
     "/users/{userId}/blockedUsers/{blockedUserId}": {
      "schema": {
        "$ref": "#/entities/blockedUser"
      },
      "description": "A subcollection storing the users blocked by this user."
    },
    "/friendRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/friendRequest"
      },
      "description": "Stores all friend requests between users."
    },
    "/dms/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/message"
      },
      "description": "Stores messages for a direct message conversation."
    },
    "/dmCalls/{callId}": {
      "schema": {
        "$ref": "#/entities/dmCall"
      },
      "description": "Stores state for direct message peer-to-peer calls."
    },
    "/servers/{serverId}": {
      "schema": {
        "$ref": "#/entities/server"
      },
      "description": "Stores server information."
    },
    "/servers/{serverId}/members/{userId}": {
      "schema": {
        "$ref": "#/entities/serverMember"
      },
      "description": "A subcollection storing the members of a server and their roles."
    },
    "/servers/{serverId}/channels/{channelId}": {
      "schema": {
        "$ref": "#/entities/channel"
      },
      "description": "A subcollection storing the channels within a server."
    },
    "/servers/{serverId}/channels/{channelId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/serverMessage"
      },
      "description": "Stores messages for a server channel."
    },
    "/servers/{serverId}/channels/{channelId}/participants/{userId}": {
      "schema": {
        "$ref": "#/entities/voiceParticipant"
      },
      "description": "Stores active participants in a voice channel for real-time WebRTC signaling."
    }
  }
}
