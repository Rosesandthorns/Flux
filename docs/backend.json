{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "A user's profile data.",
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "description": "The user's unique handle (e.g., username@flux)."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user account was created."
        },
        "status": {
          "type": "string",
          "description": "The user's status or role.",
          "default": "user"
        }
      },
      "required": ["handle", "displayName", "email", "createdAt", "status"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Stores user profile information."
    }
  }
}
