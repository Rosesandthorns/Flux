{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "A user's profile data.",
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "description": "The user's unique handle (e.g., username@flux)."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the user's profile picture."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user account was created."
        },
        "profileLastUpdatedAt": {
          "type": "string",
          "description": "The timestamp when the user's profile (name/handle) was last updated."
        },
        "status": {
          "type": "string",
          "description": "The user's status or role.",
          "default": "user"
        },
        "theme": {
          "type": "string",
          "description": "The user's preferred color theme.",
          "enum": ["default", "void", "bright", "crimson", "jade"],
          "default": "default"
        },
        "privacy": {
          "type": "object",
          "description": "User's privacy settings.",
          "properties": {
            "whoCanDm": {
              "type": "string",
              "enum": ["anyone", "friends"],
              "default": "anyone"
            },
            "whoCanAdd": {
              "type": "string",
              "enum": ["anyone", "mutual", "fof", "none"],
              "default": "anyone"
            }
          },
          "required": ["whoCanDm", "whoCanAdd"]
        },
        "notifications": {
          "type": "object",
          "description": "User's notification preferences.",
          "properties": {
            "friendRequests": {
              "type": "boolean",
              "default": true
            },
            "mentions": {
              "type": "boolean",
              "default": true
            },
            "dms": {
              "type": "boolean",
              "default": false
            }
          },
          "required": ["friendRequests", "mentions", "dms"]
        }
      },
      "required": ["handle", "displayName", "email", "createdAt", "profileLastUpdatedAt", "status", "theme", "privacy", "notifications"]
    },
    "friend": {
      "title": "Friend",
      "description": "Represents a friendship link between two users.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the friend."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the friendship was established."
        }
      },
      "required": ["userId", "createdAt"]
    },
    "friendRequest": {
        "title": "Friend Request",
        "description": "Represents a friend request sent from one user to another.",
        "type": "object",
        "properties": {
            "fromUserId": {
                "type": "string",
                "description": "The UID of the user sending the request."
            },
            "toUserId": {
                "type": "string",
                "description": "The UID of the user receiving the request."
            },
            "status": {
                "type": "string",
                "enum": ["pending"],
                "description": "The status of the friend request."
            },
            "createdAt": {
                "type": "string",
                "description": "The timestamp when the request was sent."
            }
        },
        "required": ["fromUserId", "toUserId", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/userProfile"
      },
      "description": "Stores user profile information."
    },
    "/users/{userId}/friends/{friendId}": {
      "schema": {
        "$ref": "#/entities/friend"
      },
      "description": "A subcollection storing the user's friends."
    },
    "/friendRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/friendRequest"
      },
      "description": "Stores all friend requests between users."
    }
  }
}
