rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth.uid == userId;
      // In a real production app, this should be handled by a Cloud Function for security.
      // For this prototype, we are allowing any authenticated user to write to a friends list
      // to enable client-side transactional writes for creating a friendship.
      allow write: if request.auth != null;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId 
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fromUserId != request.resource.data.toUserId;
      allow delete: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
    }
  }
}
