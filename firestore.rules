rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isServerMember(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data != null;
    }

    function isServerRole(serverId, roles) {
      let memberData = get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data;
      return memberData != null && memberData.role in roles;
    }

    // Is the user a member who is not in the 'trial' state?
    function isProperMember(serverId) {
      return isServerRole(serverId, ['owner', 'admin', 'user']);
    }

    function isServerAdmin(serverId) {
      return isServerRole(serverId, ['owner', 'admin']);
    }

    function canReadChannelContent(serverId, channelId) {
      if (!isProperMember(serverId)) {
        return false;
      }
      if (isServerAdmin(serverId)) {
        return true;
      }
      let channel = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId));
      // 'user' role check
      return channel.data.userAccess in ['readwrite', 'readonly'];
    }

    function canWriteToChannel(serverId, channelId) {
       if (!isProperMember(serverId)) {
        return false;
      }
      if (isServerAdmin(serverId)) {
        return true;
      }
      let channel = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId));
      // 'user' role check
      return channel.data.userAccess == 'readwrite';
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth != null;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId 
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fromUserId != request.resource.data.toUserId;
      allow delete: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
    }

    match /dms/{conversationId} {
      allow read, write: if request.auth.uid in conversationId.split('_');

      match /messages/{messageId} {
        allow read: if request.auth.uid in conversationId.split('_');
        allow create: if request.auth.uid in conversationId.split('_') && request.auth.uid == request.resource.data.authorId;
        allow update: if request.auth.uid == resource.data.authorId;
        allow delete: if request.auth.uid == resource.data.authorId;
      }
    }

    match /servers/{serverId} {
      allow read: if isServerMember(serverId);
      allow create: if request.auth.uid == request.resource.data.ownerId;
      allow update: if isServerAdmin(serverId);
      allow delete: if isServerRole(serverId, ['owner']);

      match /members/{userId} {
        allow read: if isServerMember(serverId);
        allow create: if request.auth.uid == userId || isServerAdmin(serverId);
        allow update: if isServerAdmin(serverId);
        allow delete: if request.auth.uid == userId || isServerAdmin(serverId);
      }

      match /channels/{channelId} {
        allow read: if isProperMember(serverId);
        allow create, update, delete: if isServerAdmin(serverId);

        match /messages/{messageId} {
            allow read: if canReadChannelContent(serverId, channelId);
            allow create: if request.auth.uid == request.resource.data.authorId && canWriteToChannel(serverId, channelId);
            allow update: if request.auth.uid == resource.data.authorId || isServerAdmin(serverId);
            allow delete: if isServerAdmin(serverId) || request.auth.uid == resource.data.authorId;
        }
      }
    }
  }
}
