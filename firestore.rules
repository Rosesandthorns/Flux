rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Deny all other writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
