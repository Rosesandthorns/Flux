rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGlobalOwner() {
      // Check if the requesting user has the 'owner' global status.
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return user.data.status == 'owner';
    }

    function isGlobalAdmin() {
      // Check if the requesting user has 'owner' or 'admin' global status.
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return user.data.status in ['owner', 'admin'];
    }
    
    function isServerMember(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data != null;
    }

    function isServerRole(serverId, roles) {
      let memberData = get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data;
      return memberData != null && memberData.role in roles;
    }

    // Is the user a member who is not in the 'trial' state?
    function isProperMember(serverId) {
      return isServerRole(serverId, ['owner', 'admin', 'user']);
    }

    function isServerOwner(serverId) {
      return isServerRole(serverId, ['owner']);
    }

    function isServerAdmin(serverId) {
      return isServerRole(serverId, ['owner', 'admin']);
    }
    
    function isBlocked(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/blockedUsers/$(uid2)) || exists(/databases/$(database)/documents/users/$(uid2)/blockedUsers/$(uid1));
    }
    
    function getOtherUid(conversationId) {
      let uids = conversationId.split('_');
      return uids[0] == request.auth.uid ? uids[1] : uids[0];
    }


    function canReadChannelContent(serverId, channelId) {
      if (!isProperMember(serverId)) {
        return false;
      }
      if (isServerAdmin(serverId)) {
        return true;
      }
      let channel = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId));
      // 'user' role check
      return channel.data.userAccess in ['readwrite', 'readonly'];
    }

    function canWriteToChannel(serverId, channelId) {
       if (!isProperMember(serverId)) {
        return false;
      }
      if (isServerAdmin(serverId)) {
        return true;
      }
      let channel = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId));
      // 'user' role check
      return channel.data.userAccess == 'readwrite';
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || (isGlobalOwner() && get(/databases/$(database)/documents/users/$(userId)).data.status != 'owner');
      allow delete: if request.auth.uid != userId && ((isGlobalAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.status == 'user') || (isGlobalOwner() && get(/databases/$(database)/documents/users/$(userId)).data.status != 'owner'));
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth != null;
    }
    
    match /users/{userId}/blockedUsers/{blockedUserId} {
        allow read, write: if request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      allow create: if request.auth.uid == request.resource.data.fromUserId 
                    && request.resource.data.status == 'pending'
                    && request.resource.data.fromUserId != request.resource.data.toUserId
                    && !isBlocked(request.resource.data.fromUserId, request.resource.data.toUserId);
      allow delete: if request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
    }

    match /dms/{conversationId} {
      allow read, write: if request.auth.uid in conversationId.split('_') && !isBlocked(request.auth.uid, getOtherUid(conversationId));

      match /messages/{messageId} {
        allow read: if request.auth.uid in conversationId.split('_') && !isBlocked(request.auth.uid, getOtherUid(conversationId));
        allow create: if request.auth.uid in conversationId.split('_') 
                      && request.auth.uid == request.resource.data.authorId 
                      && !isBlocked(request.auth.uid, getOtherUid(conversationId));
        allow update: if request.auth.uid == resource.data.authorId;
        allow delete: if request.auth.uid == resource.data.authorId || isGlobalAdmin();
      }
    }
    
    match /dmCalls/{callId} {
      function isCaller() { return request.auth.uid == resource.data.callerId; }
      function isReceiver() { return request.auth.uid == resource.data.receiverId; }
      
      allow read: if isCaller() || isReceiver();
      
      allow create: if request.auth.uid == request.resource.data.callerId 
                    && request.resource.data.status == 'ringing'
                    && !isBlocked(request.resource.data.callerId, request.resource.data.receiverId);
      
      allow update: if 
        // Receiver answers or declines
        (isReceiver() && resource.data.status == 'ringing' && request.resource.data.status in ['connected', 'declined']) ||
        // Caller cancels
        (isCaller() && resource.data.status == 'ringing' && request.resource.data.status == 'cancelled') ||
        // Either party ends the call
        ((isCaller() || isReceiver()) && resource.data.status == 'connected' && request.resource.data.status == 'ended');
    }

    match /servers/{serverId} {
      allow read: if isServerMember(serverId);
      allow create: if request.auth.uid == request.resource.data.ownerId;
      allow update: if (isServerAdmin(serverId) && request.resource.data.ownerId == resource.data.ownerId) || request.auth.uid == resource.data.ownerId;
      allow delete: if isServerOwner(serverId);

      match /members/{userId} {
        allow read: if isServerMember(serverId);
        allow create: if (request.auth.uid == userId && get(/databases/$(database)/documents/servers/$(serverId)).data.acceptingInvites == true) || isServerAdmin(serverId);
        allow update: if isServerOwner(serverId) || (isServerAdmin(serverId) && resource.data.role != 'owner' && request.resource.data.role != 'owner');
        allow delete: if request.auth.uid == userId || isServerAdmin(serverId);
      }

      match /channels/{channelId} {
        allow read: if isProperMember(serverId);
        allow create, update, delete: if isServerAdmin(serverId);

        match /participants/{userId} {
            allow read: if isProperMember(serverId);
            allow write: if request.auth.uid == userId;
        }

        match /messages/{messageId} {
            allow read: if canReadChannelContent(serverId, channelId);
            allow create: if request.auth.uid == request.resource.data.authorId && canWriteToChannel(serverId, channelId);
            allow update: if request.auth.uid == resource.data.authorId || isServerAdmin(serverId);
            allow delete: if isServerAdmin(serverId) || request.auth.uid == resource.data.authorId;
        }
      }
    }
  }
}

    